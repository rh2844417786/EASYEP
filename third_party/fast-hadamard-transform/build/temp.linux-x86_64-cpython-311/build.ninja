ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-13.0/bin/nvcc

cflags = -pthread -Wsign-compare -Wunreachable-code -DNDEBUG -g -fwrapv -O3 -Wall -O3 -fstack-protector -fstack-clash-protection -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=2 -fno-omit-frame-pointer -mno-omit-leaf-frame-pointer -fPIC -fPIC -I/home/jovyan/wangtonghan/EASYEP/third_party/fast-hadamard-transform -I/opt/sglang-v4/lib/python3.11/site-packages/torch/include -I/opt/sglang-v4/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda-13.0/include -I/opt/sglang-v4/include -I/opt/uv-python/cpython-3.11.15-linux-x86_64-gnu/include/python3.11 -c
post_cflags = -O3 -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=fast_hadamard_transform_cuda -std=c++17
cuda_cflags = -I/home/jovyan/wangtonghan/EASYEP/third_party/fast-hadamard-transform -I/opt/sglang-v4/lib/python3.11/site-packages/torch/include -I/opt/sglang-v4/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda-13.0/include -I/opt/sglang-v4/include -I/opt/uv-python/cpython-3.11.15-linux-x86_64-gnu/include/python3.11 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O3 -U__CUDA_NO_HALF_OPERATORS__ -U__CUDA_NO_HALF_CONVERSIONS__ -U__CUDA_NO_BFLOAT16_OPERATORS__ -U__CUDA_NO_BFLOAT16_CONVERSIONS__ -U__CUDA_NO_BFLOAT162_OPERATORS__ -U__CUDA_NO_BFLOAT162_CONVERSIONS__ --expt-relaxed-constexpr --expt-extended-lambda --use_fast_math --ptxas-options=-v -lineinfo --threads 4 -gencode arch=compute_75,code=sm_75 -gencode arch=compute_80,code=sm_80 -gencode arch=compute_87,code=sm_87 -gencode arch=compute_90,code=sm_90 -gencode arch=compute_100,code=sm_100 -gencode arch=compute_120,code=sm_120 -gencode arch=compute_103,code=sm_103 -gencode arch=compute_110,code=sm_110 -gencode arch=compute_121,code=sm_121 -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=fast_hadamard_transform_cuda -std=c++17
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc -MD -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







